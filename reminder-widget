def parse_input(text):
    """Turn a typed "@..." suffix into an absolute due time. Returns (title, datetime|None, has_time, lead)."""
    m = DUE_RE.search(text)
    if not m:
        return text, None, False, DEFAULT_LEAD
    day, hm = m.group(1), m.group(2)
    today = date.today()
    if re.fullmatch(r"\d{1,2}:\d{2}", day) and not hm:
        d, hm = today, day
    elif day == "오늘":
        d = today
    elif day == "내일":
        d = today + timedelta(days=1)
    elif day == "모레":
        d = today + timedelta(days=2)
    else:
        try:
            nums = [int(p) for p in re.split(r"[-/.]", day)]
            d = date(today.year, *nums) if len(nums) == 2 else date(*nums)
        except (ValueError, TypeError):
            return text, None, False, DEFAULT_LEAD
    try:
        h, mi = map(int, hm.split(":")) if hm else DEFAULT_TIME
        return text[:m.start()].strip(), datetime(d.year, d.month, d.day, h, mi), bool(hm), DEFAULT_LEAD
    except ValueError:
        return text, None, False, DEFAULT_LEAD


def parse_stored(line):
    """Read the "@YYYY-MM-DD[ HH:MM -<lead>m]" suffix that items.txt keeps."""
    m = STORED_RE.search(line)
    if not m:
        return line, None, False, DEFAULT_LEAD
    d = date.fromisoformat(m.group(1))
    h, mi = map(int, m.group(2).split(":")) if m.group(2) else DEFAULT_TIME
    lead = int(m.group(3)) if m.group(3) else DEFAULT_LEAD
    return line[:m.start()], datetime(d.year, d.month, d.day, h, mi), bool(m.group(2)), lead


def format_item(title, due, has_time, lead):
    if not due:
        return title
    return title + f" @{due:%Y-%m-%d}" + (f" {due:%H:%M} -{lead}m" if has_time else "")


def alert_at(due, has_time, lead):
    """Date-only items alert at DEFAULT_TIME on the day; timed items alert lead minutes early."""
    return due - timedelta(minutes=lead) if has_time else due


def lead_label(lead):
    return dict(LEADS).get(lead) or f"{lead}분 전"


def due_label(dt, has_time):
    days = (dt.date() - date.today()).days
    day = {0: "오늘", 1: "내일", -1: "어제"}.get(days)
    if day is None:
        day = f"{dt.month}/{dt.day} ({WEEKDAYS[dt.weekday()]})"
        if dt.year != date.today().year:
            day = f"{dt.year}/" + day
    return f"{day} {dt:%H:%M}" if has_time else day


def check_button():
    # A 12 px icon keeps the 18 px circle round; a text "✓" made it taller than wide.
    b = Gtk.Button()
    b.set_image(Gtk.Image.new_from_icon_name("object-select-symbolic", Gtk.IconSize.MENU))
    b.get_image().set_pixel_size(12)
    b.set_always_show_image(True)
    return b


def load(path=ITEMS):
    return [l for l in path.read_text().splitlines() if l.strip()] if path.exists() else []


def save(items, path=ITEMS):
    DATA.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(i + "\n" for i in items))


def notify(title, due, has_time):
    when = due_label(due, has_time)
    subprocess.Popen(["notify-send", "-u", "critical", "-a", "리마인더", title, f"⏰ {when}"])
    subprocess.Popen(["paplay", SOUND], stderr=subprocess.DEVNULL)


def top_bar_menu(win):
    """Icon in the Ubuntu top bar with "항상 위", "사용법" and "종료"."""
    try:
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3 as AI
    except (ValueError, ImportError):
        return None  # no top-bar support here; the widget works without it
    icons = Path(__file__).resolve().parent / "icons"  # resolve() follows the ~/.local/bin symlink
    ind = AI.Indicator.new_with_path("reminder-widget", "reminder-widget-symbolic",
                                     AI.IndicatorCategory.APPLICATION_STATUS, str(icons))
    ind.set_title("리마인더")
    ind.set_status(AI.IndicatorStatus.ACTIVE)
    menu = Gtk.Menu()
    on_top = Gtk.CheckMenuItem(label="항상 위")
    on_top.set_active(win.on_top)
    on_top.connect("toggled", lambda item: win.set_on_top(item.get_active()))
    help_item = Gtk.MenuItem(label="사용법")
    help_item.connect("activate", lambda *_: Gtk.show_uri_on_window(None, HELP_URL, Gdk.CURRENT_TIME))
    quit_item = Gtk.MenuItem(label="종료")
    quit_item.connect("activate", lambda *_: Gtk.main_quit())
    for item in (on_top, help_item, Gtk.SeparatorMenuItem(), quit_item):
        menu.append(item)
    menu.show_all()
    ind.set_menu(menu)
    return ind


class DatePicker(Gtk.Window):
    """Month grid, then hour/minute. Calls done(datetime, has_time); closes on Esc or focus loss."""

    def __init__(self, parent, x, y, done, lead=DEFAULT_LEAD):
        super().__init__(transient_for=parent)
        self.done = done
        self.finished = False
        self.lead = lead
        self.connect("destroy", lambda *_: self.finished or self.done(None, False, 0))
        self.day = None
        t = date.today()
        self.year, self.month = t.year, t.month
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.move(x, y)
        self.connect("key-press-event", self.on_key)
        self.connect("focus-out-event", lambda *_: self.destroy())

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.get_style_context().add_class("picker")
        self.add(self.box)
        self.show_month()
        self.show_all()
        self.present()

    @staticmethod
    def button(text, *classes, on=None):
        b = Gtk.Button(label=text)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_can_focus(False)
        for c in classes:
            b.get_style_context().add_class(c)
        if on:
            b.connect("clicked", lambda *_: on())
        return b

    def clear(self):
        for c in self.box.get_children():
            self.box.remove(c)

    def shift(self, step):
        m = self.month - 1 + step
        self.year, self.month = self.year + m // 12, m % 12 + 1
        self.show_month()

    def show_month(self):
        self.clear()
        head = Gtk.Box(spacing=4)
        title = Gtk.Label(label=f"{self.year}년 {self.month}월", xalign=0)
        title.get_style_context().add_class("month")
        head.pack_start(title, True, True, 4)
        head.pack_start(self.button("‹", "nav", on=lambda: self.shift(-1)), False, False, 0)
        head.pack_start(self.button("›", "nav", on=lambda: self.shift(1)), False, False, 0)
        self.box.pack_start(head, False, False, 0)

        grid = Gtk.Grid(column_spacing=2, row_spacing=2, column_homogeneous=True)
        for i, wd in enumerate("일월화수목금토"):
            lab = Gtk.Label(label=wd)
            lab.get_style_context().add_class("wd")
            grid.attach(lab, i, 0, 1, 1)
        first = date(self.year, self.month, 1)
        start = first - timedelta(days=(first.weekday() + 1) % 7)  # Sunday-first rows
        for n in range(42):
            d = start + timedelta(days=n)
            if n % 7 == 0 and n and d.month != self.month:
                break
            classes = ["day"]
            if d.month != self.month:
                classes.append("other")
            if d == date.today():
                classes.append("today")
            elif d.weekday() == 6 and d.month == self.month:
                classes.append("sun")
            grid.attach(self.button(str(d.day), *classes, on=lambda d=d: self.pick(d)),
                        n % 7, n // 7 + 1, 1, 1)
        self.box.pack_start(grid, False, False, 0)
        self.box.show_all()
        self.resize(1, 1)

    def pick(self, d):
        self.day = d
        now = datetime.now()
        self.h = min(23, now.hour + 1) if d == date.today() else DEFAULT_TIME[0]
        self.m = 0
        self.show_time()

    def show_time(self):
        self.clear()
        title = Gtk.Label(label="⏰ " + due_label(datetime.combine(self.day, datetime.min.time()), False),
                          xalign=0)
        title.get_style_context().add_class("ptitle")
        self.box.pack_start(title, False, False, 0)

        self.labels = {}
        clock = Gtk.Box(spacing=4, halign=Gtk.Align.CENTER)
        for key, step in (("h", 1), ("m", 5)):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            num = Gtk.Label()
            num.get_style_context().add_class("num")
            wheel = Gtk.EventBox()
            wheel.add_events(Gdk.EventMask.SCROLL_MASK)
            wheel.connect("scroll-event", self.on_scroll, key, step)
            wheel.add(num)
            col.pack_start(self.button("▲", "step", on=lambda k=key, s=step: self.bump(k, s)), False, False, 0)
            col.pack_start(wheel, False, False, 0)
            col.pack_start(self.button("▼", "step", on=lambda k=key, s=step: self.bump(k, -s)), False, False, 0)
            self.labels[key] = num
            clock.pack_start(col, False, False, 0)
            if key == "h":
                colon = Gtk.Label(label=":")
                colon.get_style_context().add_class("colon")
                clock.pack_start(colon, False, False, 0)
        self.box.pack_start(clock, False, False, 0)

        chips = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        for h in (9, 12, 15, 18, 21):
            chips.pack_start(self.button(f"{h:02d}:00", "chip", on=lambda h=h: self.set_time(h, 0)), False, False, 0)
        self.box.pack_start(chips, False, False, 0)

        sub = Gtk.Label(label="알림", xalign=0)
        sub.get_style_context().add_class("sub")
        self.box.pack_start(sub, False, False, 0)
        leads = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
        self.lead_buttons = {}
        for i, (mins, text) in enumerate(LEADS):
            b = self.button(text, "chip", on=lambda mins=mins: self.set_lead(mins))
            self.lead_buttons[mins] = b
            leads.attach(b, i % 3, i // 3, 1, 1)
        self.box.pack_start(leads, False, False, 0)
        self.set_lead(self.lead)

        btns = Gtk.Box(spacing=6)
        btns.pack_start(self.button("‹ 날짜", "later", on=self.show_month), False, False, 0)
        btns.pack_end(self.button("확인", "ok", on=lambda: self.finish(True)), False, False, 0)
        btns.pack_end(self.button("시간 없이", "later", on=lambda: self.finish(False)), False, False, 0)
        self.box.pack_start(btns, False, False, 0)
        self.update_clock()
        self.box.show_all()
        self.resize(1, 1)

    def set_lead(self, mins):
        self.lead = mins
        for m, b in self.lead_buttons.items():
            ctx = b.get_style_context()
            (ctx.add_class if m == mins else ctx.remove_class)("sel")

    def update_clock(self):
        self.labels["h"].set_text(f"{self.h:02d}")
        self.labels["m"].set_text(f"{self.m:02d}")

    def set_time(self, h, m):
        self.h, self.m = h, m
        self.update_clock()

    def bump(self, key, step):
        if key == "h":
            self.h = (self.h + step) % 24
        else:
            self.m = (self.m + step) % 60
        self.update_clock()

    def on_scroll(self, _w, ev, key, step):
        up = ev.direction == Gdk.ScrollDirection.UP or (
            ev.direction == Gdk.ScrollDirection.SMOOTH and ev.delta_y < 0)
        self.bump(key, step if up else -step)
        return True

    def finish(self, with_time):
        h, m = (self.h, self.m) if with_time else DEFAULT_TIME
        self.finished = True
        self.done(datetime(self.day.year, self.day.month, self.day.day, h, m), with_time, self.lead)
        self.destroy()

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.destroy()
        elif ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and self.day:
            self.finish(True)


class Widget(Gtk.Window):
    def __init__(self):
        super().__init__(title="Reminders")
        self.items = load()
        self.done = load(DONE)  # newest first
        self.view = "todo"
        self.fading = set()  # checked items still fading out; several can run at once
        self.faded_rows = []  # their emptied rows, folded together when the last one ends
        self.confirm_clear = False
        self.clear_token = None
        self.seg_anim = None
        self.seg_pos = 0.0
        self.adding = False
        self.editing = None
        # Items already past due at startup do not fire again; ones still ahead fire if their alert time passed.
        self.fired = {i for i in self.items if (d := parse_stored(i)[1]) and d <= datetime.now()}
        self.state = None
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.on_top = ON_TOP.exists()
        self.set_layer()
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        if POS.exists():
            x, y = map(int, POS.read_text().split())
            self.move(x, y)
        # Only the width is the user's; the height always follows the number of items.
        self.user_width = int(SIZE.read_text().split()[0]) if SIZE.exists() else DEFAULT_WIDTH
        self.user_resizing = False
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.on_press)
        self.connect("configure-event", self.on_moved)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_window_key)

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.card.get_style_context().add_class("card")
        self.card.set_size_request(306, -1)  # includes the 26 px CSS margin on each side
        self.add(self.card)
        self.render()
        GLib.timeout_add_seconds(15, self.tick)
        self.indicator = top_bar_menu(self)

    def on_moved(self, *_):
        DATA.mkdir(parents=True, exist_ok=True)
        POS.write_text("%d %d" % self.get_position())
        if self.user_resizing:
            self.user_width = self.get_size()[0]
            SIZE.write_text("%d" % self.user_width)

    def on_press(self, _w, ev):
        """Presses that no button or row took: Ctrl+drag resizes, a drag above the list line moves."""
        if ev.button != 1:
            return False
        if not ev.state & Gdk.ModifierType.CONTROL_MASK:
            _, hy = self.header.translate_coordinates(self, 0, 0)
            line = hy + self.header.get_allocated_height() + 6  # the header's bottom padding
            if ev.y_root - self.get_position()[1] < line:
                # Stay on top while dragging, or the widget vanishes behind windows on the other monitor.
                self.set_layer(front=True)
                self.begin_move_drag(ev.button, int(ev.x_root), int(ev.y_root), ev.time)
                GLib.timeout_add(100, self.sink_after_drag, ev.device)
                return True
            return False
        # Ctrl+drag widens or narrows from the nearer side edge; height is never dragged.
        left_half = ev.x_root - self.get_position()[0] < self.get_size()[0] / 2
        edge = Gdk.WindowEdge.WEST if left_half else Gdk.WindowEdge.EAST
        self.user_resizing = True
        self.begin_resize_drag(edge, ev.button, int(ev.x_root), int(ev.y_root), ev.time)
        return True

    def view_state(self):
        now = datetime.now()
        return date.today(), tuple((d := parse_stored(i)[1]) is not None and d <= now for i in self.items)

    def tick(self):
        now = datetime.now()
        for item in self.items:
            title, due, has_time, lead = parse_stored(item)
            if due and alert_at(due, has_time, lead) <= now and item not in self.fired:
                self.fired.add(item)
                notify(title, due, has_time)
        # Redraw when an item turns overdue or the day changes ("내일" -> "오늘").
        if not (self.adding or self.fading) and self.editing is None and self.view_state() != self.state:
            self.render()
        return True

    def render(self):
        self.state = self.view_state()
        self.user_resizing = False  # size changes from here on come from content
        for c in self.card.get_children():
            self.card.remove(c)

        hbox = self.header = Gtk.Box(spacing=6)
        # Two-way tab: the same control in the same place on both views, only the lit side changes.
        seg = self.seg = Gtk.Box()
        seg.get_style_context().add_class("seg")
        seg.connect("draw", self.draw_seg_pill)  # runs before the tab labels draw on top
        if self.seg_anim is None:
            self.seg_pos = 0.0 if self.view == "todo" else 1.0
        self.todo_tab = self.tab("할 일", len(self.items), "todo")
        self.done_tab = self.tab("완료", len(self.done), "done")
        seg.pack_start(self.todo_tab, False, False, 0)
        seg.pack_start(self.done_tab, False, False, 0)
        seg.set_valign(Gtk.Align.CENTER)
        hbox.pack_start(seg, False, False, 0)
        self.card.pack_start(hbox, False, False, 6)
        if self.view == "done":
            hbox.pack_end(self.trash_button(), False, False, 0)  # sits where + is on the to-do view
            self.render_done()
            self.finish_render(None)
            return
        plus = self.plus_btn = Gtk.Button(label="+")
        plus.get_style_context().add_class("plus")
        plus.set_relief(Gtk.ReliefStyle.NONE)
        plus.connect("clicked", self.on_plus)
        hbox.pack_end(plus, False, False, 0)

        now = datetime.now()
        entry = None
        for idx, item in enumerate(self.items):
            if idx == self.editing:
                entry = self.add_entry_row(*parse_stored(item))
                continue
            text, due, has_time, _lead = parse_stored(item)
            row = Gtk.Box(spacing=12)
            row.get_style_context().add_class("item")
            chk = check_button()
            chk.get_style_context().add_class("chk")
            chk.set_valign(Gtk.Align.CENTER)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lab = Gtk.Label(label=text, xalign=0)
            lab.set_line_wrap(True)
            lab.set_max_width_chars(24)
            col.pack_start(lab, False, False, 0)
            rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_UP,
                               transition_duration=300, reveal_child=True)
            chk.connect("clicked", self.on_check, item, lab, rev)
            if due:
                dl = Gtk.Label(label="⏰ " + due_label(due, has_time), xalign=0)
                dl.get_style_context().add_class("due")
                if due <= now:
                    dl.get_style_context().add_class("overdue")
                col.pack_start(dl, False, False, 0)
            # Clicking the text opens it for editing.
            click = Gtk.EventBox()
            click.add(col)
            click.connect("button-press-event", self.on_edit, idx)
            row.pack_start(chk, False, False, 0)
            row.pack_start(click, True, True, 0)
            rev.add(row)
            self.card.pack_start(rev, False, False, 0)

        if self.adding:
            entry = self.add_entry_row("")
        elif not self.items:
            empty = Gtk.Label(label="할 일이 없습니다", xalign=0)
            empty.get_style_context().add_class("empty")
            self.card.pack_start(empty, False, False, 0)
        self.finish_render(entry)

    def finish_render(self, entry):
        self.card.show_all()
        if entry:
            self.update_hint(entry)
        self.resize(self.user_width, 1)  # chosen width, height fitted to the items
        self.set_layer(front=bool(entry))  # come to the front while typing, go back afterwards
        if entry:
            self.present()
            entry.grab_focus()
            entry.set_position(-1)

    def add_entry_row(self, text, due=None, has_time=False, lead=DEFAULT_LEAD):
        row = Gtk.Box(spacing=12)
        row.get_style_context().add_class("item")
        dot = Gtk.Box()
        dot.get_style_context().add_class("chk")
        dot.set_opacity(0.4)
        dot.set_valign(Gtk.Align.CENTER)
        entry = Gtk.Entry(text=text, placeholder_text="새 리마인더  (@ 로 날짜 지정)")
        entry.connect("key-press-event", self.on_key)
        entry.connect("changed", self.on_typing)
        self.last_len = len(text)
        self.pending = (due, has_time, lead) if due else None
        row.pack_start(dot, False, False, 0)
        row.pack_start(entry, True, True, 0)
        self.card.pack_start(row, False, False, 0)

        # Due-date pill under the entry: click to change, x to clear.
        self.hint_row = Gtk.Box(spacing=2)
        self.hint_row.get_style_context().add_class("hintrow")
        self.hint = Gtk.Label(xalign=0)
        self.hint.get_style_context().add_class("hint")
        pill = Gtk.EventBox()
        pill.add(self.hint)
        pill.connect("button-press-event", lambda *_: self.open_picker(entry))
        clear = Gtk.Button(label="✕")
        clear.set_relief(Gtk.ReliefStyle.NONE)
        clear.connect("clicked", lambda *_: self.set_pending(entry, None))
        self.hint_row.pack_start(pill, False, False, 0)
        self.hint_row.pack_start(clear, False, False, 0)
        self.card.pack_start(self.hint_row, False, False, 0)
        return entry

    def on_edit(self, _w, ev, idx):
        if ev.button == 1 and not ev.state & Gdk.ModifierType.CONTROL_MASK:
            self.adding = False
            self.editing = idx
            self.render()

    def on_typing(self, entry):
        text = entry.get_text()
        typed_at = text.endswith("@") and len(text) > self.last_len
        self.last_len = len(text)
        if typed_at:
            self.open_picker(entry)
        self.update_hint(entry)

    def update_hint(self, entry):
        due, has_time, lead = self.pending or parse_input(entry.get_text())[1:]
        if due:
            self.hint.set_text("⏰ " + due_label(due, has_time)
                               + (f" · {lead_label(lead)} 알림" if has_time else ""))
            self.hint_row.show()
        else:
            self.hint_row.hide()
        self.resize(self.user_width, 1)

    def set_pending(self, entry, pending):
        self.pending = pending
        self.update_hint(entry)
        entry.grab_focus()
        entry.set_position(-1)

    def open_picker(self, entry):
        ex, ey = entry.translate_coordinates(self, 0, 0)
        wx, wy = self.get_position()
        h = entry.get_allocated_height()

        def done(due, has_time, lead):
            # Drop the typed "@" so the entry holds only the title.
            text = entry.get_text()
            if "@" in text:
                self.last_len = 0
                entry.set_text(text[:text.rfind("@")].rstrip())
            self.present()
            self.set_pending(entry, (due, has_time, lead) if due else self.pending)

        # Same window margin on both, so the picker card lines up with the widget card.
        DatePicker(self, wx, wy + ey + h - 20, done,
                   self.pending[2] if self.pending else DEFAULT_LEAD)

    def on_plus(self, _b):
        self.view = "todo"
        self.adding = True
        self.editing = None
        self.render()

    def on_window_key(self, _w, ev):
        """Enter on the widget (while no entry is open) starts a new item."""
        typing = self.adding or self.editing is not None
        if ev.keyval in ENTER_KEYS and not typing:
            self.on_plus(None)
            return True
        return False

    def on_add(self, entry, keep_adding=False):
        title, due, has_time, lead = parse_input(entry.get_text().strip())
        if self.pending and not due:
            due, has_time, lead = self.pending
        if title:
            item = format_item(title, due, has_time, lead)
            if due and due <= datetime.now():
                self.fired.add(item)
            if self.editing is None:
                self.items.append(item)
            else:
                self.items[self.editing] = item
            save(self.items)
        # Enter while adding saves and opens the next empty entry; Ctrl+Enter saves and stops.
        self.adding = keep_adding and self.editing is None and bool(title)
        self.editing = None
        self.render()

    def on_key(self, entry, ev):
        if ev.keyval in ENTER_KEYS:
            self.on_add(entry, keep_adding=not ev.state & Gdk.ModifierType.CONTROL_MASK)
            return True
        if ev.keyval == Gdk.KEY_Escape:
            self.adding = False
            self.editing = None
            self.render()

    def tab(self, text, count, view):
        b = Gtk.Button()
        lab = Gtk.Label()
        lab.set_markup(f'{text} <span size="smaller" alpha="60%">{count}</span>')
        b.add(lab)
        b.set_relief(Gtk.ReliefStyle.NONE)
        if self.view == view:
            b.get_style_context().add_class("on")
        b.connect("clicked", self.on_tab, view)
        return b

    def render_done(self):
        for item in self.done:
            text, due, has_time, _lead = parse_stored(item)
            row = Gtk.Box(spacing=12)
            row.get_style_context().add_class("item")
            chk = check_button()
            for c in ("chk", "filled"):
                chk.get_style_context().add_class(c)
            chk.set_valign(Gtk.Align.CENTER)
            chk.set_tooltip_text("복원")
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lab = Gtk.Label(xalign=0)
            lab.set_markup(f"<s>{GLib.markup_escape_text(text)}</s>")
            lab.get_style_context().add_class("struck")
            lab.set_line_wrap(True)
            lab.set_max_width_chars(24)
            col.pack_start(lab, False, False, 0)
            if due:
                dl = Gtk.Label(label="⏰ " + due_label(due, has_time), xalign=0)
                for c in ("due", "gray"):
                    dl.get_style_context().add_class(c)
                col.pack_start(dl, False, False, 0)
            rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_UP,
                               transition_duration=250, reveal_child=True)
            chk.connect("clicked", self.on_restore, item, lab, rev)
            row.pack_start(chk, False, False, 0)
            row.pack_start(col, True, True, 0)
            rev.add(row)
            self.card.pack_start(rev, False, False, 0)
        if not self.done:
            empty = Gtk.Label(label="완료한 항목이 없습니다", xalign=0)
            empty.get_style_context().add_class("empty")
            self.card.pack_start(empty, False, False, 0)

    def trash_button(self):
        """Grey bin; the first click turns it red, the second empties the done list."""
        b = self.trash_btn = Gtk.Button()
        icon = Gtk.Image.new_from_icon_name("user-trash-symbolic", Gtk.IconSize.MENU)
        icon.set_pixel_size(15)
        b.add(icon)
        b.get_style_context().add_class("trash")
        if self.confirm_clear:
            b.get_style_context().add_class("armed")
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_tooltip_text("한 번 더 누르면 모두 지웁니다" if self.confirm_clear else "완료 목록 비우기")
        b.set_sensitive(bool(self.done))
        b.connect("clicked", self.on_clear)
        return b

    def sink_after_drag(self, device):
        if self.get_window().get_device_position(device)[3] & Gdk.ModifierType.BUTTON1_MASK:
            return True  # still dragging
        self.set_layer(front=self.adding or self.editing is not None)
        return False

    def set_layer(self, front=False):
        """Above other windows when "항상 위" is on or while typing/dragging; otherwise on the desktop."""
        above = front or self.on_top
        self.set_keep_below(not above)
        self.set_keep_above(above)

    def set_on_top(self, on):
        self.on_top = on
        DATA.mkdir(parents=True, exist_ok=True)
        ON_TOP.touch() if on else ON_TOP.unlink(missing_ok=True)
        self.set_layer()

    def on_tab(self, _b, view):
        if self.view == view:
            return
        self.view = view
        self.adding = False
        self.editing = None
        self.confirm_clear = False
        start = self.seg_pos
        self.render()
        self.seg_pos = start  # render() snaps the pill to the new tab; glide from where it was
        self.slide_seg(0.0 if view == "todo" else 1.0)

    def slide_seg(self, target):
        """Glide the white pill from one tab to the other."""
        start, t0 = self.seg_pos, GLib.get_monotonic_time()
        self.seg_anim = token = object()

        def step(*_):
            if self.seg_anim is not token:
                return False
            k = min(1.0, (GLib.get_monotonic_time() - t0) / (SEG_MS * 1000))
            e = 1 - (1 - k) ** 3  # ease-out
            self.seg_pos = start + (target - start) * e
            self.seg.queue_draw()
            if k < 1:
                return True
            self.seg_anim = None
            return False

        self.add_tick_callback(step)

    def draw_seg_pill(self, seg, cr):
        boxes = []
        for tab in (self.todo_tab, self.done_tab):
            x, y = tab.translate_coordinates(seg, 0, 0)
            boxes.append((x, y, tab.get_allocated_width(), tab.get_allocated_height()))
        (x0, y, w0, h), (x1, _, w1, _) = boxes
        p = self.seg_pos
        x, w = x0 + (x1 - x0) * p, w0 + (w1 - w0) * p

        def pill(px, py, pw, ph):
            r = ph / 2
            cr.new_sub_path()
            cr.arc(px + pw - r, py + r, r, -math.pi / 2, math.pi / 2)
            cr.arc(px + r, py + r, r, math.pi / 2, 3 * math.pi / 2)
            cr.close_path()

        pill(0, 0, seg.get_allocated_width(), seg.get_allocated_height())
        cr.set_source_rgba(0, 0, 0, 0.06)      # grey track
        cr.fill()
        pill(x, y + 1, w, h)
        cr.set_source_rgba(0, 0, 0, 0.10)      # soft shadow under the pill
        cr.fill()
        pill(x, y, w, h)
        cr.set_source_rgb(1, 1, 1)             # the white pill
        cr.fill()
        return False

    def on_check(self, btn, item, lab, rev):
        if item in self.fading:
            return
        self.fading.add(item)
        btn.get_style_context().add_class("done")
        lab.set_markup(f"<s>{GLib.markup_escape_text(lab.get_text())}</s>")
        lab.get_style_context().add_class("struck")
        GLib.timeout_add(300, self.fade_out, rev, item, self.move_to_done)

    def fade_out(self, rev, item, move):
        """Fade the row away. Its space stays until every pending check has faded."""
        row, t0 = rev.get_child(), GLib.get_monotonic_time()

        def step(*_):
            k = min(1.0, (GLib.get_monotonic_time() - t0) / (FADE_MS * 1000))
            row.set_opacity(1 - k)
            if k < 1:
                return True
            self.finish_fade(item, rev, move)
            return False

        self.add_tick_callback(step)
        return False

    def finish_fade(self, item, rev, move):
        self.fading.discard(item)
        move(item)
        save(self.items)
        save(self.done, DONE)
        self.update_counts()
        self.faded_rows.append(rev)
        if not self.fading:
            # Wait a moment before closing the gaps, so rows do not move under the pointer
            # while the user is still going down the list.
            GLib.timeout_add(FOLD_DELAY_MS, self.fold_faded)

    def fold_faded(self):
        if self.fading or not self.faded_rows:
            return False  # a newer check is running; it will fold everything when it ends
        for r in self.faded_rows:  # fold all the emptied rows shut together
            r.set_reveal_child(False)
        self.faded_rows = []
        end = GLib.get_monotonic_time() + 300_000

        def shrink(*_):  # let the window follow the folding rows instead of leaving a blank strip
            self.resize(self.user_width, 1)
            if GLib.get_monotonic_time() < end:
                return True
            self.after_fold()
            return False

        self.add_tick_callback(shrink)
        return False

    def after_fold(self):
        if not (self.fading or self.adding or self.editing is not None):
            self.render()
        return False

    def update_counts(self):
        for tab, text, n in ((self.todo_tab, "할 일", len(self.items)), (self.done_tab, "완료", len(self.done))):
            tab.get_child().set_markup(f'{text} <span size="smaller" alpha="60%">{n}</span>')

    def move_to_done(self, item):
        if item in self.items:
            self.items.remove(item)
            self.done.insert(0, item)

    def move_to_todo(self, item):
        if item in self.done:
            self.done.remove(item)
            self.items.append(item)
            due = parse_stored(item)[1]
            if due and due <= datetime.now():
                self.fired.add(item)

    def on_restore(self, btn, item, lab, rev):
        """Reverse of a check: the circle empties, the strike goes, then the row fades out."""
        if item in self.fading:
            return
        self.fading.add(item)
        btn.get_style_context().remove_class("filled")
        lab.set_text(lab.get_text())
        lab.get_style_context().remove_class("struck")
        GLib.timeout_add(300, self.fade_out, rev, item, self.move_to_todo)

    def on_clear(self, _b):
        if not self.confirm_clear:
            self.confirm_clear = True
            self.clear_token = token = object()
            self.trash_btn.get_style_context().add_class("armed")  # same widget, so the colour fades in
            self.trash_btn.set_tooltip_text("한 번 더 누르면 모두 지웁니다")
            GLib.timeout_add_seconds(3, self.reset_clear, token)
            return
        self.done = []
        save(self.done, DONE)
        self.confirm_clear = False
        self.render()

    def reset_clear(self, token):
        if self.confirm_clear and token is self.clear_token:  # ignore timers from an earlier arming
            self.confirm_clear = False
            self.trash_btn.get_style_context().remove_class("armed")
            self.trash_btn.set_tooltip_text("완료 목록 비우기")
        return False

